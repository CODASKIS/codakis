# PostgreSQL local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TON_MOT_DE_PASSE
POSTGRES_DB=codaski_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Ou URL complète :
# DATABASE_URL=postgresql+psycopg://postgres:TON_MOT_DE_PASSE@localhost:5432/codaski_db

# JWT — JWT_SECRET ou SECRET_KEY
SECRET_KEY=change-me-in-production-use-long-random-string
ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14

# Admin créé au démarrage si absent
DEFAULT_ADMIN_EMAIL=admin@codakis.cm
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_PRENOM=Admin
DEFAULT_ADMIN_NOM=CODAKIS

# Google OAuth — même Client ID que VITE_GOOGLE_CLIENT_ID (frontend)
# Console : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# E-mail — mode test : console (OTP et mots de passe affichés dans les logs)
# Modes : console | smtp
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@codakis.cm

# OTP
OTP_EXPIRE_MINUTES=15
OTP_LENGTH=6

# CORS (frontend Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Environnement : development | test | production
APP_ENV=development

# ElevenLabs — lecture audio des leçons et quiz (optionnel)
ELEVENLABS_API_KEY=
# Voix par langue (Charlotte FR, George EN par défaut — changez dans ElevenLabs > Voix)
ELEVENLABS_VOICE_ID_FR=XB0fDUnXU5powFXDhCwa
ELEVENLABS_VOICE_ID_EN=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
