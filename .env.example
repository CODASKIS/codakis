# Variables partagées CODAKIS (docker compose + Vite build)

# --- Docker / déploiement ---
WEB_PORT=8080
POSTGRES_USER=codakis
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=codakis_db

# JWT — obligatoire en production
SECRET_KEY=change-me-in-production-use-long-random-string

# URL publique du portail (CORS + liens e-mail)
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# --- Frontend (build Vite) ---
# Laisser vide : Nginx proxy /api → backend en Docker.
# En dev local sans Docker : VITE_API_URL=http://localhost:8000
VITE_API_URL=

# Google OAuth — même Client ID que GOOGLE_CLIENT_ID côté API
# Console : https://console.cloud.google.com/apis/credentials
# Origines autorisées : http://localhost:8080 (prod Docker) et http://localhost:5173 (dev)
VITE_GOOGLE_CLIENT_ID=

# --- E-mail (optionnel) ---
# Modes : console | smtp
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@codakis.cm

# --- TTS ElevenLabs (optionnel) ---
ELEVENLABS_API_KEY=
