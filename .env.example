# Variables partagées CODAKIS (docker compose + Vite build)

# --- Docker / déploiement ---
WEB_PORT=8080
POSTGRES_USER=codakis
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=codakis_db

# JWT — obligatoire en production
SECRET_KEY=change-me-in-production-use-long-random-string

# URL publique du portail (CORS + liens e-mail)
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# --- Frontend (build Vite) ---
# Laisser vide : Nginx proxy /api → backend en Docker.
# En dev local sans Docker : VITE_API_URL=http://localhost:8000
VITE_API_URL=

# Google OAuth — même Client ID que GOOGLE_CLIENT_ID côté API
# Console : https://console.cloud.google.com/apis/credentials
# Origines JavaScript autorisées (exactes, sans slash final) :
#   http://localhost:5173
#   http://localhost:8080
#   https://codakis.efymotors.com
#   https://codakis.etymotors.com
#   https://codakis.cm
#   https://www.codakis.cm
# Erreur 400 origin_mismatch = l'origine du navigateur n'est pas listée ci-dessus.
VITE_GOOGLE_CLIENT_ID=

# --- E-mail ---
# Modes : console | resend | smtp
# Resend (gratuit ~100/jour) : https://resend.com — recommandé pour les tests
EMAIL_MODE=resend
RESEND_API_KEY=
EMAIL_FROM_NAME=CODAKIS
SMTP_FROM=onboarding@resend.dev

# Brevo SMTP (alternative gratuite ~300/jour) — EMAIL_MODE=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=votre-email@example.com
# SMTP_PASSWORD=cle-smtp-brevo

# --- TTS ElevenLabs (optionnel) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID_FR=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID_EN=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Assistant IA Mistral (cours / quiz) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Paiements ---
# PawaPay (prioritaire si le token est défini et que FRONTEND_URL est en HTTPS)
PAWAPAY_TOKEN=
PAWAPAY_SANDBOX=true
# Narration SMS / page (4–22 car. alphanum). Le libellé « Payment to … » se change
# dans le dashboard PawaPay (company / nameDisplayedToCustomer → CODAKIS).
PAWAPAY_CUSTOMER_MESSAGE=CODAKIS
PAYMENT_RETURN_BASE_URL=

# CinetPay (secours)
# Dashboard : https://cinetpay.com/login — récupérez API KEY, SITE ID et mot de passe API
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
CINETPAY_SITE_ID=
CINETPAY_CURRENCY=XAF
