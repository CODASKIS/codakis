# Variables partagées CODAKIS (racine monorepo — lues par Vite)

# Laisser vide pour utiliser le proxy Vite /api → localhost:8000
VITE_API_URL=

# Google OAuth — même Client ID que GOOGLE_CLIENT_ID dans backend/.env
# Créer sur https://console.cloud.google.com/apis/credentials
# Origines autorisées : http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
